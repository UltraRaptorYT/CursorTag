{
  "name": "cursor-tag",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib cloudflare next.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit && tsc --project cloudflare/tsconfig.json",
    "realtime:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "realtime:types": "wrangler types cloudflare/worker-configuration.d.ts --config cloudflare/wrangler.jsonc",
    "realtime:check": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc",
    "realtime:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "realtime:tail": "wrangler tail --config cloudflare/wrangler.jsonc",
    "realtime:smoke": "bun scripts/realtime-smoke.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.123.0"
  },
  "packageManager": "bun@1.2.13",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
